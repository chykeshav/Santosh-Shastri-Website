# ─────────────────────────────────────────────────────────
# .env.example  –  Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────
PORT=3000
SQLITE_DB_PATH=./database/bookings.db

# ── Gmail SMTP ────────────────────────────────────────────
# Use a Gmail App Password (NOT your real Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soumyamarriagebureau@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Admin Dashboard (basic auth) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── Admin notifications – sent on every new booking ──────
# Email: where the "new booking" alert goes (defaults to SMTP_USER if left blank)
ADMIN_NOTIFY_EMAIL=soumyamarriagebureau@gmail.com

# WhatsApp (via CallMeBot, free): Santosh ji WhatsApps +34 644 51 90 78 with
# "I allow callmebot to send me messages", gets an apikey back — put it here.
ADMIN_WHATSAPP_APIKEY=
# His own WhatsApp number, country code + digits only, no + or spaces, e.g. 919323152991
ADMIN_WHATSAPP_PHONE=919323152991

# ── CORS – any extra frontend origins to allow, comma-separated ──
# *.vercel.app, santoshshastri.site / www.santoshshastri.site, and localhost are
# already allowed by default — only needed for anything beyond that.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=https://example-preview.vercel.app,https://another-domain.com

# ── Frontend build variable ───────────────────────────────
# Set to wherever you actually deploy the backend (Railway, Render, or a
# custom api.santoshshastri.site) — it's trusted directly, whatever the host.
VITE_BACKEND_URL=https://santoshshastri-backend-production.up.railway.app
