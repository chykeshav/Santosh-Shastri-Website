# ─────────────────────────────────────────────────────────
# .env.example  –  Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────
PORT=3000
SQLITE_DB_PATH=./database/bookings.db

# ── Gmail SMTP ────────────────────────────────────────────
# Use a Gmail App Password (NOT your real Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soumyamarriagebureau@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Admin Dashboard (basic auth) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── CORS – set to your deployed frontend URL on Render ───
# e.g. https://santoshshastri-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# ── Frontend build variable ───────────────────────────────
# Set to your deployed backend URL on Render
# e.g. https://santoshshastri-backend.onrender.com
VITE_BACKEND_URL=https://santoshshastri-backend-production.up.railway.app
