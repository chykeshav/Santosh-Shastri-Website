{
  "name": "santoshshastri-backend",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "build:frontend": "node -e \"const fs=require('fs'); const cp=require('child_process'); if(fs.existsSync('../frontend/package.json')){ cp.execSync('npm install', {cwd: '../frontend', stdio: 'inherit'}); cp.execSync('npm run build', {cwd: '../frontend', stdio: 'inherit'}); }\"",
    "build": "npm run build:frontend && tsc"
  },
  "dependencies": {
    "basic-auth": "^2.0.1",
    "better-sqlite3": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nodemailer": "^6.9.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/basic-auth": "^1.1.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
